# ============================================================
# wrangler dev 用のローカル secrets テンプレート
# `cp .dev.vars.example .dev.vars` してから値を埋める
#
# 重要: wrangler dev は .dev.vars が存在すると .env.local を無視するため、
# dev で worker が必要とする secrets はすべてここに書く必要がある。
# ============================================================

# ------------------------------------------------------------
# Telegram (dev 用 bot を @BotFather で別途作成)
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# 自分の chat.id (本番と同じで OK)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# Notion (dummy で OK。実 dev DB を使うなら実値)
# ------------------------------------------------------------
NOTION_TOKEN=ntn_dummy_dev_token
NOTION_TASKS_DB_ID=00000000000000000000000000000000

# ------------------------------------------------------------
# Anthropic / Google: 本番と同じ値で OK
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------
# /admin/run 用トークン（手動でジョブ再実行する際の Bearer 認証）
# `openssl rand -hex 32` で生成した値を入れる。本番は wrangler secret put ADMIN_TOKEN
# ------------------------------------------------------------
ADMIN_TOKEN=
