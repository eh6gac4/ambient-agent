# ============================================================
# wrangler dev 用のローカル secrets テンプレート
# `cp .dev.vars.example .dev.vars` してから値を埋める
#
# 重要: wrangler dev は .dev.vars が存在すると .env.local を無視するため、
# dev で worker が必要とする secrets はすべてここに書く必要がある。
# ============================================================

# ------------------------------------------------------------
# Telegram (dev 用 bot を @BotFather で別途作成)
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# 自分の chat.id (本番と同じで OK)
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# トリガー認証トークン（任意の乱数文字列）
# ------------------------------------------------------------
ALERT_TOKEN=dev-alert-token
OWNTRACKS_TOKEN=dev-owntracks-token

# ------------------------------------------------------------
# タスクストア (D1/R2) は secret ではなくバインディング。
# wrangler dev はローカルエミュレーション（本番の notion-tasks D1 とは別物）を
# 使うので、dev で /tasks 等を試すときは下記でスキーマを流し込む:
#   npx wrangler d1 execute notion-tasks --local --file=<notion-tasks>/migrations/0001_init.sql
# ------------------------------------------------------------

# ------------------------------------------------------------
# Anthropic / Google: 本番と同じ値で OK
# ------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
