# ============================================================
# ローカル dev 環境用の環境変数テンプレート
# `cp .env.dev.local.example .env.dev.local` してから値を埋める
# このファイルは `npm run dev` / `npm run webhook:dev` で読み込まれる
# ============================================================

# ------------------------------------------------------------
# Telegram (dev 専用 bot を @BotFather で別途作成すること)
# ------------------------------------------------------------
# 本番 bot とは別の dev bot のトークン
TELEGRAM_BOT_TOKEN=
# 自分の chat.id（本番と同じで OK。bot が違うので衝突しない）
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# Notion (dev 用 DB を別途作成すること。空 or ダミーで OK)
# 既存タスク DB を Notion 上で複製 → インテグレーションを接続 → URL末尾32文字
# ------------------------------------------------------------
NOTION_TOKEN=ntn_
NOTION_TASKS_DB_ID=

# ------------------------------------------------------------
# Anthropic / Google: 本番と同じ値で OK（dev 専用は不要）
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
